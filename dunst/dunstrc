[global]
frame_color = "#89b4fa"
separator_color= frame
highlight = "#89b4fa"
indicate_hidden = yes
transparency = 0
shrink = no
font = monospace 11
word_wrap = yes
ellipsis = middle
ignore_newline = no
sticky_history= yes
history_length = 20
follow = keyboard
width = (0, 400)
height = 200
origin = bottom-right
offset = 16x48
scale = 0
notification_limit = 5
padding = 10
horizontal_padding = 12
icon_theme = "Papirus-Dark"
icon_position = left
icon_size = 32
gap_size = 8
timeout = 5
format = "%s %b"

[urgency_low]
background = "#1e1e2e"
foreground = "#cdd6f4"

[urgency_normal]
background = "#1e1e2e"
foreground = "#cdd6f4"

[urgency_critical]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#fab387"
